<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@android:drawable/screen_background_dark_transparent"
    android:padding="8dp">

    <ImageButton android:id="@+id/widget_prev" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="48dp" android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" />
    <ImageButton android:id="@+id/widget_play" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="48dp" android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_play" android:contentDescription="Play or pause" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="48dp" android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_next" android:contentDescription="Next" />
</LinearLayout>
